# Render injects DATABASE_URL from the nova-postgres database resource.
# Never commit a real database URL or session secret.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
SESSION_SECRET=generate-a-long-random-secret-in-Render
# Comma-separated login email(s) that may administer NOVA support inbox.
# Set this only in Render Environment, never in client-side code.
NOVA_ADMIN_EMAILS=admin@example.com
